#include ws281x-rpi0w.frag
##unclude dev-tools.frag

BR2_PACKAGE_LIBCONFIG=y
BR2_PACKAGE_LED_ALARM=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES+="$(BR2_EXTERNAL_JLBSP_PATH)/board/led-alarm/linux-rtc.frag"

BR2_TARGET_GENERIC_HOSTNAME="led-alarm"

BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/led-alarm/config.txt" 

BR2_PACKAGE_JL_SECRET_KEYS_LED_ALARM=y

BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_RTC_TOOLS=y

BR2_PACKAGE_NTP_NTPTIME=y
BR2_PACKAGE_NTP_TICKADJ=y
