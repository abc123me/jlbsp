#include rpi2-dev.config
#unclude dev-tools.frag

# enables the PPS, GPS and NTP subsystems of the kernel
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES+="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/linux.frag"

# include custom config / cmdline to disable uart console since its used by gps module
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/config.txt"

# since this is an actual system, add in the production scripts
BR2_ROOTFS_OVERLAY+="$(BR2_EXTERNAL_JLBSP_PATH)/board/common/skeleton-prod"
BR2_ROOTFS_DEVICE_TABLE+="$(BR2_EXTERNAL_JLBSP_PATH)/board/common/skeleton-prod.txt"

# using chrony as the NTP server since it's the best
BR2_PACKAGE_CHRONY=y

# gpsd is an excellent way to handle gps
BR2_PACKAGE_GPSD=y
BR2_PACKAGE_GPSD_CLIENTS=y
BR2_PACKAGE_GPSD_DAEMON=y
BR2_PACKAGE_GPSD_DEVICES="/dev/ttyAMA0"
BR2_PACKAGE_GPSD_GROUP=y
BR2_PACKAGE_GPSD_GROUP_VALUE="gps"
BR2_PACKAGE_GPSD_USER=y
BR2_PACKAGE_GPSD_USER_VALUE="gps"

# pps tools for debugging
BR2_PACKAGE_PPS_TOOLS=y

# lighttpd with php as a minimal web server for remote monitoring
BR2_PACKAGE_LIGHTTPD=y
BR2_PACKAGE_PHP=y
BR2_PACKAGE_PHP_SAPI_FPM=y
# BR2_PACKAGE_PHP_SAPI_CGI is not set
# BR2_PACKAGE_PHP_SAPI_CLI is not set
# BR2_PACKAGE_PHP_EXT_SESSION is not set
# BR2_PACKAGE_PHP_EXT_ZLIB is not set
# BR2_PACKAGE_PHP_EXT_POSIX is not set

# include out gps server keys
BR2_PACKAGE_JL_SECRET_KEYS=y
# BR2_PACKAGE_JL_SECRET_KEYS_DEV is not set
BR2_PACKAGE_JL_SECRET_KEYS_NTP=y

BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
# BR2_PACKAGE_NTP_NTPD is not set

# Add in overlays for the NTP server
BR2_ROOTFS_OVERLAY+="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/skeleton"
BR2_ROOTFS_DEVICE_TABLE+="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/skeleton.txt"
BR2_ROOTFS_USERS_TABLES+="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/users.txt"

# Perform some pruning via a post-fakeroot script
BR2_ROOTFS_POST_FAKEROOT_SCRIPT+="$(BR2_EXTERNAL_JLBSP_PATH)/support/prune.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT_ARGS+="$(BR2_EXTERNAL_JLBSP_PATH)/board/ntp/prune.txt"

# Finally set hostname
BR2_TARGET_GENERIC_HOSTNAME="ntp"
