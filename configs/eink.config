#include ws281x-rpi0w.frag
#unclude dev-tools.frag

BR2_PACKAGE_LIBCONFIG=y
BR2_PACKAGE_LED_ALARM=y

# include custom kernel and rpi firmware config to enable the eink display hardware
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/eink/config.txt" 

# include in led-alarm keys
BR2_PACKAGE_JL_SECRET_KEYS=y
BR2_PACKAGE_JL_SECRET_KEYS_DEV=y

# Add in overlays for led-alarm
BR2_ROOTFS_OVERLAY+="$(BR2_EXTERNAL_JLBSP_PATH)/board/eink/skeleton"
BR2_ROOTFS_DEVICE_TABLE+="$(BR2_EXTERNAL_JLBSP_PATH)/board/eink/skeleton.txt"

# Finally set hostname
BR2_TARGET_GENERIC_HOSTNAME="eink"
