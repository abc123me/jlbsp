#include z7lite_defconfig
#include common.frag

BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_ROOTFS_OVERLAY+="$(BR2_EXTERNAL_JLBSP_PATH)/board/screen-hat/skeleton"
BR2_ROOTFS_DEVICE_TABLE+="$(BR2_EXTERNAL_JLBSP_PATH)/board/screen-hat/skeleton.txt"

# Custom kernel here since xilinx is special
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES is not set
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/screen-hat/linux.config"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR+="$(BR2_EXTERNAL_JLBSP_PATH)/board/screen-hat/dts"

BR2_TARGET_UBOOT_ZYNQ_PS7_INIT_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/screen-hat/fpga/ps7_init_gpl.c"

BR2_TARGET_GENERIC_HOSTNAME="screen-hat"

BR2_PACKAGE_JL_SECRET_KEYS=y
# BR2_PACKAGE_JL_SECRET_KEYS_DEV is not set
BR2_PACKAGE_JL_SECRET_KEYS_SCREEN_HAT=y

# Enable core graphics driver
BR2_PACKAGE_DRIVER_DDMAFB=y

# Enable some core framebuffer testing apps
BR2_PACKAGE_FB_TEST_APP=y

# Enable SDL2
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_X11=y

# Enable X11 + Xorg
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y

# Enable some X11 utils
BR2_PACKAGE_WMCTRL=y
BR2_PACKAGE_XTERM=y

# Enable screen hat base apps
# BR2_PACKAGE_SCREEN_HAT_RS=y

