#include raspberrypi5_defconfig
#include rpi-dev.frag

#include_only BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION raspberrypi5_defconfig

# BR2_LINUX_KERNEL_USE_DEFCONFIG is not set
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/rpi/configs/bcm2712_defconfig"

BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/rpi/5/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_JLBSP_PATH)/board/rpi/5/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

BR2_TARGET_GENERIC_HOSTNAME="rpi5-dev"
