kernel_addr_r=0x21000000
fdt_addr_r=0x20000000
bootcmd=for dev in 0 1; do fatload mmc ${dev}:1 ${kernel_addr_r} Image; fatload mmc ${dev}:1 ${fdt_addr_r} system.dtb; setenv bootargs root=/dev/mmcblk${dev}p2 rootwait; echo booting from MMC${dev}; printenv bootargs; booti ${kernel_addr_r} - ${fdt_addr_r}; done
