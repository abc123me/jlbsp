#!/usr/bin/env bash

csv() { echo "$1" | awk -F':' "{print \$$2}"; }

run_iptables() {
	m="$1"
	shift 1
	for rng in "$@"; do
		ext_if="$(csv "$rng" 1)"
		ext_port="$(csv "$rng" 2)"
		int_addr="$(csv "$rng" 3)"
		int_port="$(csv "$rng" 4)"
		int_if="$(csv "$rng" 5)"
		iptables "$m" PREROUTING -t nat -p tcp -i "$ext_if" --dport "$ext_port" -j DNAT --to-destination "${int_addr}:${int_port}"
		iptables "$m" POSTROUTING -t nat -p tcp -d "$int_addr" --dport "$int_port" -j MASQUERADE
		iptables "$m" FORWARD -p tcp -o "$int_if" -d "$int_addr" --dport "$int_port" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
	done
}

media_ip="192.168.1.12"
eth_if="eth0"
vpn_if="wg0"

runfn="/var/run/.wg-proxyd-${vpn_if}"
fwd=("${eth_if}:80:${media_ip}:80:${vpn_if}" "${eth_if}:443:${media_ip}:443:${vpn_if}")
route=("-net" "${media_ip}" "netmask" "255.255.255.255" "metric" "1024" "dev" "${vpn_if}")
vpn_addr=$(cat "/etc/wireguard/${vpn_if}.conf" | grep Endpoint | awk '{print $NF}' | awk -F':' '{print $1}')

case "$1" in
	up)
		if [ -f "${runfn}" ]; then "$0" down || rm -f "${runfn}"; fi
		ifup "${vpn_if}"
		sleep 3
		run_iptables -A "${fwd[@]}"
		route add "${route[@]}"
		touch "${runfn}"
		;;
	down)
		run_iptables -D "${fwd[@]}"
		route del "${route[@]}"
		ifdown "${vpn_if}"
		rm -f "${runfn}"
		;;
esac
