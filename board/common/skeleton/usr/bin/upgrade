#!/usr/bin/env sh

img="$1"

[ -z "$img" ] && img="/tmp/sdcard.img"

if [ ! -f "$img" ]; then
	echo "Failed to find image: $img" 1>&2
	echo "Usage: $0 [image default=/tmp/sdcard.img]" 1>&2
	exit 1
fi

set -eou pipefail

. /usr/share/jlbsp/utils

if [ -f "/usr/share/jlbsp/upgrade-hooks" ]; then
	echo "Sourcing upgrade-hooks script"
	. "/usr/share/jlbsp/upgrade-hooks"
fi

run_hook() {
	hook="upgrade_$1"; shift 1
	if type "$hook" >/dev/null; then
		echo -e "\e[1;36mRunning custom $hook hook\e[0m"
		"$hook" "$@"
	fi
}

# TODO: This probably could use some simplification, in fact all three of these arguments
# are likely not necessary since we can use the symlinks on device to figure it out

# do_upgrade <rootfs partition number> <image location> <block device>"
do_upgrade() {
	echo -e "\e[1;33mLoop device created and upgrade partition layout validated, relocating rootfs\e[0m"
	run_hook pre_remount "$1" "$2" "$3" "${dev}p${1}"
	# Not sure why, but crond causes random intermittent failures in the upgrade process
	killall -SIGINT crond || echo "Attempted and failed to stop crond"
	swapoff -a
	mount -o remount,ro / || true
	mkdir -p /tmp/newroot
	mount -o ro "${dev}p${1}" /tmp/newroot
	run_hook pivot_root "$1" "$2" "$3" "${dev}p${1}"
	sync
	pivot_root /tmp/newroot /tmp/newroot/mnt
	cd /
	mount -t sysfs sysfs /sys
	mount -t devtmpfs devtmpfs /dev
	mount -t proc proc /proc
	mount -t tmpfs tmpfs /tmp
	run_hook pre_dd "$1" "$2" "$3" "/mnt"
	echo "Rootfs pivoted, loop device now on /, old root on /mnt"
	cnt=3
	sz="$(du -b "/mnt/$2" | awk '{print $1}')"
	echo -e "\e[1;33mGetting crc of loopdev ramdisk!\e[0m"
	ecrc="$(dd "if=/mnt/$2" bs=16M iflag=count_bytes count="$sz" | crc32)"
	while [ $cnt -gt 0 ]; do
		echo -e "\e[1;33mFlashing image!\e[0m"
		echo dd "if=/mnt/$2" "of=$3" bs=4M conv=fsync
		dd "if=/mnt/$2" "of=$3" bs=4M conv=fsync
		echo -e "\e[1;33mVerifying image!\e[0m"
		crc="$(dd if="$3" bs=4M iflag=count_bytes count="$sz" | crc32)"
		if [ "$crc" = "$ecrc" ]; then
			echo -e "\e[1;32mImage verified, rebooting!\e[0m"
			break;
		else
			echo -e "\e[1;31mVerification failed, $crc != $ecrc, $cnt tries remaining!\e[0m"
		fi
		cnt=$((cnt-1))
	done
	run_hook reboot "$1" "$2" "$3" "/mnt"
	reboot
	# syncing could cause issues with the rootfs
}
err_part_layout() {
	echo "$1 has invalid partition layout!" 1>&2
	exit 1
}

modprobe loop

validate_x86() {
	[ -b "${2}1" ] && [ ! -b "${2}2" ] && return 0
	return 1
}

validate_arm() {
	[ -b "${2}1" ] && [ -b "${2}2" ] && [ ! -b "${2}3" ] && return 0
	return 1
}

dev="$(losetup -f)"
rimg="$(realpath "$img")"
oblk="$(realpath /dev/root | sed 's/p\?[0-9]\+$//g')"
part_num="0"
part_name=""
validate_func="false"

if uname -m | grep -q 'x86'; then
	echo -e "\e[1;33mX86 / AMD64 architecture detected, expecting a single /root partition with MBR at ${oblk}\e[0m"
	part_num="1"; part_name="${oblk}"; validate_func="validate_x86"
elif uname -m | grep -q 'arm' || uname -m | grep -q 'aarch'; then
	echo -e "\e[1;33mARM architecture detected, expecting /boot + /root layout, at ${oblk}\e[0m"
	part_num="2"; part_name="${oblk}p"; validate_func="validate_arm"
else
	echo -e "\e[1;31mUnknown architecture detected, only valid for arm or x86 architectures!\e[0m" 2>&1
	exit 1
fi

wait_for_cancel 5
run_hook start
if "$validate_func" "orig" "$part_name"; then
	echo "Partition layout is valid, creating loop device to perform upgrade"
	run_hook pre_losetup
	losetup -P "$dev" "$img"
	run_hook post_losetup
	if "$validate_func" "loop" "${dev}p"; then
		do_upgrade "$part_num" "$rimg" "$oblk"
	else err_part_layout "Upgrade image / loop device"; fi
else err_part_layout "Base device"; fi
